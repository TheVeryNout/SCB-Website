    "@tailwindcss/vite": "^4.2.2",
    "astro": "^6.1.5",
    "concurrently": "^9.2.1",
    "decap-server": "^3.6.0",
    "sharp": "0.34.5",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@netlify/identity": "1.2.0",
    "photoswipe": "5.4.4"
  }
