{
  "name": "scb-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.5",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:cms": "concurrently -k -n site,cms -c cyan,yellow \"astro dev\" \"PORT=4335 decap-server\"",
