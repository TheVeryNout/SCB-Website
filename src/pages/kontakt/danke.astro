---
import Container from "../../components/Container.astro";
import LinkButton from "../../components/LinkButton.astro";
import SurfaceCard from "../../components/SurfaceCard.astro";
import { getSiteSettingsEntry } from "../../lib/content/site";
import BaseLayout from "../../layouts/BaseLayout.astro";

const settings = await getSiteSettingsEntry();
---

<BaseLayout
  title={`Danke für deine Nachricht | ${settings.data.organizationName}`}
  description="Bestätigungsseite nach dem Absenden des Kontaktformulars."
>
  <section class="py-16 sm:py-24">
    <Container class="max-w-2xl">
      <SurfaceCard as="section" tone="warm" class="flex flex-col items-center text-center">
        <span class="flex h-16 w-16 items-center justify-center rounded-full bg-[#414141] text-[#ead871]" aria-hidden="true">
          <svg viewBox="0 0 24 24" class="h-8 w-8" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12.5l4.5 4.5L19 7.5" />
          </svg>
        </span>
        <h1 class="scb-display mt-6 text-[clamp(1.875rem,5vw,3rem)] leading-tight text-[#353636] uppercase text-balance">
          Danke für deine Nachricht!
        </h1>
        <p class="mt-4 max-w-md text-lg leading-8 text-[#414141] text-balance">
          Sie ist beim Verein angekommen. Wir melden uns so bald wie möglich bei dir.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <LinkButton href="/">Zur Startseite</LinkButton>
          <LinkButton href="/neuigkeiten/" variant="outline">Zu den News</LinkButton>
        </div>
      </SurfaceCard>
    </Container>
  </section>
</BaseLayout>
