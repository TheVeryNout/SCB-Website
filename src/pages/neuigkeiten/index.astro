---
import Container from "../../components/Container.astro";
import EditorialImage from "../../components/EditorialImage.astro";
import PageIntro from "../../components/PageIntro.astro";
import { getAllPosts, getSiteSettingsEntry } from "../../lib/content/site";
import BaseLayout from "../../layouts/BaseLayout.astro";

const [settings, posts] = await Promise.all([
  getSiteSettingsEntry(),
  getAllPosts(),
]);

const [leadPost, ...archivePosts] = posts;
const dateFormatter = new Intl.DateTimeFormat("de-DE", {
  day: "2-digit",
  month: "long",
  year: "numeric",
});
---

<BaseLayout
  title={`Neuigkeiten | ${settings.data.organizationName}`}
  description="Aktuelle Vereinsnachrichten, Rückblicke und öffentliche Updates des Skate Club Biriciana e.V."
>
  <section class="scb-section py-14 sm:py-20">
    <Container class="min-w-0 space-y-10 sm:space-y-14">
      <PageIntro
        eyebrow="Neuigkeiten"
        title="Geschichten aus Verein, Szene und Skatepark"
        intro="Aktuelle Meldungen, Veranstaltungsrückblicke und Einblicke in die Projekte des Skate Club Biriciana."
        class="[&_h1]:break-words [&_h1]:text-[clamp(2.5rem,10vw,4.5rem)] [&_h1]:leading-[0.95]"
      />

      {
        leadPost ? (
          <div class="space-y-10">
            <article class="grid min-w-0 overflow-hidden border border-[#414141]/40 bg-[#fffdf2] lg:grid-cols-[1.2fr_0.8fr]">
              {
                leadPost.data.coverImage ? (
                  <a href={`/neuigkeiten/${leadPost.data.slug}/`} class="block min-h-[16rem] no-underline lg:min-h-[28rem]">
                    <EditorialImage
                      src={leadPost.data.coverImage}
                      alt={leadPost.data.coverAlt ?? `Titelbild zum Beitrag ${leadPost.data.title}`}
                      class="h-full min-h-[16rem] border-0 lg:min-h-[28rem]"
                      sizes="(min-width: 1024px) 42rem, 100vw"
                      loading="eager"
                    />
                  </a>
                ) : (
                  <div class="min-h-[16rem] bg-[#414141]" aria-hidden="true" />
                )
              }

              <div class="flex min-w-0 flex-col justify-center p-6 sm:p-9 lg:p-10">
                <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-xs font-semibold tracking-[0.13em] text-[#414141]/75 uppercase">
                  <time datetime={new Date(leadPost.data.publishedAt).toISOString()}>
                    {dateFormatter.format(new Date(leadPost.data.publishedAt))}
                  </time>
                  {leadPost.data.category ? <span aria-hidden="true">·</span> : null}
                  {leadPost.data.category ? <span>{leadPost.data.category}</span> : null}
                </div>
                <h2 class="scb-display mt-5 break-words text-[clamp(2.25rem,6vw,4.25rem)] leading-[0.98] text-[#414141] uppercase">
                  <a class="no-underline hover:text-[#b14926]" href={`/neuigkeiten/${leadPost.data.slug}/`}>
                    {leadPost.data.title}
                  </a>
                </h2>
                <p class="mt-5 text-base leading-7 text-[#414141] sm:text-lg">{leadPost.data.excerpt}</p>
                <a
                  href={`/neuigkeiten/${leadPost.data.slug}/`}
                  class="mt-7 inline-flex w-fit border border-[#414141] px-5 py-3 text-sm font-semibold tracking-[0.08em] text-[#414141] no-underline uppercase transition hover:bg-[#414141] hover:text-[#ead871]"
                >
                  Beitrag lesen
                </a>
              </div>
            </article>

            {
              archivePosts.length ? (
                <div>
                  <div class="mb-6 flex items-end justify-between gap-4 border-b border-[#414141]/35 pb-4">
                    <h2 class="scb-display text-3xl text-[#414141] uppercase sm:text-4xl">Weitere Meldungen</h2>
                    <p class="hidden text-sm text-[#414141]/70 sm:block">Chronologisch sortiert</p>
                  </div>
                  <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
                    {archivePosts.map((post) => (
                      <article class="flex min-w-0 flex-col overflow-hidden border border-[#414141]/35 bg-[#fffdf2]">
                        {
                          post.data.coverImage ? (
                            <a href={`/neuigkeiten/${post.data.slug}/`} class="block no-underline">
                              <EditorialImage
                                src={post.data.coverImage}
                                alt={post.data.coverAlt ?? `Titelbild zum Beitrag ${post.data.title}`}
                                class="aspect-[4/3] border-0"
                                sizes="(min-width: 1280px) 22rem, (min-width: 768px) 50vw, 100vw"
                                loading="lazy"
                              />
                            </a>
                          ) : (
                            <div class="aspect-[4/3] bg-[#414141]" aria-hidden="true" />
                          )
                        }
                        <div class="flex flex-1 flex-col p-5 sm:p-6">
                          <div class="flex flex-wrap gap-x-2 text-xs font-semibold tracking-[0.12em] text-[#414141]/70 uppercase">
                            <time datetime={new Date(post.data.publishedAt).toISOString()}>
                              {dateFormatter.format(new Date(post.data.publishedAt))}
                            </time>
                            {post.data.category ? <span>· {post.data.category}</span> : null}
                          </div>
                          <h3 class="mt-3 break-words text-2xl font-semibold leading-tight text-[#414141]">
                            <a class="no-underline hover:text-[#b14926]" href={`/neuigkeiten/${post.data.slug}/`}>
                              {post.data.title}
                            </a>
                          </h3>
                          <p class="mt-3 flex-1 text-sm leading-6 text-[#414141]/85">{post.data.excerpt}</p>
                          <a class="mt-5 w-fit font-semibold text-[#414141]" href={`/neuigkeiten/${post.data.slug}/`}>
                            Weiterlesen
                          </a>
                        </div>
                      </article>
                    ))}
                  </div>
                </div>
              ) : null
            }
          </div>
        ) : (
          <div class="border border-[#414141]/35 bg-[#fffdf2] p-8 sm:p-10">
            <h2 class="text-2xl font-semibold text-[#414141]">Noch keine Meldungen</h2>
            <p class="mt-3 leading-7 text-[#414141]">Sobald es Neuigkeiten gibt, erscheinen sie an dieser Stelle.</p>
          </div>
        )
      }
    </Container>
  </section>
</BaseLayout>
