---
import { render } from "astro:content";

import Container from "../../components/Container.astro";
import PostCover from "../../components/PostCover.astro";
import PostGallery from "../../components/PostGallery.astro";
import RichText from "../../components/RichText.astro";
import { getAllPosts, getLatestPosts, getSiteSettingsEntry } from "../../lib/content/site";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getAllPosts();

  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const settings = await getSiteSettingsEntry();
const { Content } = await render(post);
const latestPosts = (await getLatestPosts(3))
  .filter((candidate) => candidate.data.slug !== post.data.slug)
  .slice(0, 2);
const dateFormatter = new Intl.DateTimeFormat("de-DE", {
  day: "2-digit",
  month: "long",
  year: "numeric",
});
---

<BaseLayout title={`${post.data.title} | ${settings.data.organizationName}`} description={post.data.excerpt}>
  <section class="scb-section py-10 sm:py-16">
    <Container class="min-w-0 space-y-6">
      <a
        href="/neuigkeiten/"
        class="inline-flex border border-[#414141] px-4 py-3 text-sm font-semibold tracking-[0.07em] text-[#414141] no-underline uppercase transition hover:bg-[#414141] hover:text-[#ead871]"
      >
        ← Alle Neuigkeiten
      </a>

      <article class="min-w-0 overflow-hidden border border-[#414141]/35 bg-[#fffdf2]" aria-labelledby="post-heading">
        <header class="mx-auto max-w-3xl px-5 py-10 sm:px-8 sm:py-14 lg:py-16">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-xs font-semibold tracking-[0.13em] text-[#414141]/70 uppercase">
            <time datetime={new Date(post.data.publishedAt).toISOString()}>
              {dateFormatter.format(new Date(post.data.publishedAt))}
            </time>
            {post.data.category ? <span aria-hidden="true">·</span> : null}
            {post.data.category ? <span>{post.data.category}</span> : null}
          </div>
          <h1 id="post-heading" class="scb-display mt-5 break-words text-[clamp(2.65rem,9vw,5.75rem)] leading-[0.95] text-[#414141] uppercase">
            {post.data.title}
          </h1>
          <p class="mt-6 text-lg leading-8 text-[#414141] sm:text-xl sm:leading-9">{post.data.excerpt}</p>
        </header>

        {
          post.data.coverImage ? (
            <PostCover
              src={post.data.coverImage}
              alt={post.data.coverAlt ?? `Titelbild zum Beitrag ${post.data.title}`}
              caption={post.data.coverCaption}
              mode={post.data.coverMode}
            />
          ) : null
        }

        <div class="mx-auto max-w-3xl px-5 py-10 sm:px-8 sm:py-14">
          <RichText class="article-rich-text">
            <Content />
          </RichText>
        </div>

        {post.data.gallery?.length ? <PostGallery items={post.data.gallery} /> : null}
      </article>

      {
        latestPosts.length ? (
          <section aria-labelledby="latest-posts-heading" class="border border-[#414141]/35 bg-[#f4eeb5] p-5 sm:p-8">
            <p class="scb-display text-sm tracking-[0.16em] text-[#b14926] uppercase">Weiterlesen</p>
            <h2 id="latest-posts-heading" class="mt-2 text-2xl font-semibold text-[#414141]">Neueste Meldungen</h2>
            <div class="mt-6 grid gap-4 md:grid-cols-2">
              {latestPosts.map((latestPost) => (
                <article class="border border-[#414141]/25 bg-[#fffdf2] p-5">
                  <time class="text-xs font-semibold tracking-[0.12em] text-[#414141]/65 uppercase" datetime={new Date(latestPost.data.publishedAt).toISOString()}>
                    {dateFormatter.format(new Date(latestPost.data.publishedAt))}
                  </time>
                  <h3 class="mt-2 break-words text-xl font-semibold leading-tight text-[#414141]">
                    <a class="no-underline hover:text-[#b14926]" href={`/neuigkeiten/${latestPost.data.slug}/`}>
                      {latestPost.data.title}
                    </a>
                  </h3>
                  <p class="mt-3 text-sm leading-6 text-[#414141]/80">{latestPost.data.excerpt}</p>
                </article>
              ))}
            </div>
          </section>
        ) : null
      }
    </Container>
  </section>
</BaseLayout>
