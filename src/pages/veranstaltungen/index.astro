---
import Container from "../../components/Container.astro";
import LinkButton from "../../components/LinkButton.astro";
import PageIntro from "../../components/PageIntro.astro";
import SurfaceCard from "../../components/SurfaceCard.astro";
import UpcomingEventsList from "../../components/events/UpcomingEventsList.astro";
import { getRequiredPageEntry, getUpcomingOccurrences, getSiteSettingsEntry } from "../../lib/content/site";
import BaseLayout from "../../layouts/BaseLayout.astro";

const EVENT_PAGE_OPTIONS = {
  horizonPastMonths: 0,
  horizonFutureMonths: 4,
} as const;

const [settings, eventsPage, allUpcomingOccurrences] = await Promise.all([
  getSiteSettingsEntry(),
  getRequiredPageEntry("events"),
  getUpcomingOccurrences(undefined, EVENT_PAGE_OPTIONS),
]);

const upcomingOccurrences = allUpcomingOccurrences.slice(0, 6);
const additionalInfo = eventsPage.data.additionalInfo;
const showAdditionalInfo = Boolean(
  additionalInfo?.enabled && (additionalInfo.title || additionalInfo.text),
);
---

<BaseLayout
  title={`${eventsPage.data.title} | ${settings.data.organizationName}`}
  description={eventsPage.data.intro}
>
  <section class="scb-section py-16 sm:py-20">
    <Container class="space-y-10">
      <PageIntro
        eyebrow={eventsPage.data.eyebrow ?? "Veranstaltungen"}
        title={eventsPage.data.title}
        intro={eventsPage.data.intro}
      >
        <div class="flex flex-wrap gap-3">
          <LinkButton href={`mailto:${settings.data.contactEmail}`} variant="outline">
            Frage zum Termin stellen
          </LinkButton>
        </div>
      </PageIntro>

      <div class="grid gap-5 xl:grid-cols-[1fr_1.1fr]">
        <SurfaceCard as="section" aria-labelledby="upcoming-events-heading">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="text-sm font-semibold tracking-[0.18em] text-slate-500 uppercase">Nächste Termine</p>
              <h2 id="upcoming-events-heading" class="mt-2 text-2xl font-semibold text-slate-950">
                {eventsPage.data.listTitle ?? "Was als Nächstes ansteht"}
              </h2>
              {
                eventsPage.data.listIntro ? (
                  <p class="mt-2 max-w-xl text-sm leading-6 text-slate-600">
                    {eventsPage.data.listIntro}
                  </p>
                ) : null
              }
            </div>
            <p class="text-sm text-slate-600">
              {allUpcomingOccurrences.length} öffentliche Termin{allUpcomingOccurrences.length === 1 ? "" : "e"} im sichtbaren Zeitraum
            </p>
          </div>
          <UpcomingEventsList occurrences={upcomingOccurrences} />
        </SurfaceCard>

        {showAdditionalInfo ? (
          <SurfaceCard
            as="section"
            tone="warm"
            aria-label={additionalInfo?.title ?? additionalInfo?.label ?? "Zusatzinfos"}
          >
            <p class="text-sm font-semibold tracking-[0.18em] text-slate-500 uppercase">
              {additionalInfo?.label ?? "Zusatzinfos"}
            </p>
            {
              additionalInfo?.title ? (
                <h2 class="mt-2 text-2xl font-semibold text-slate-950">
                  {additionalInfo.title}
                </h2>
              ) : null
            }
            {
              additionalInfo?.text ? (
                <p class="mt-3 text-sm leading-7 text-slate-700">
                  {additionalInfo.text}
                </p>
              ) : null
            }
          </SurfaceCard>
        ) : null}
      </div>
    </Container>
  </section>
</BaseLayout>
