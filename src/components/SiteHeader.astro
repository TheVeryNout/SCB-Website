---
import Container from "./Container.astro";
import crest from "../assets/images/wix-staging/shared/site/dfbc4d_0c5a0de8605c42cbbf4d5ebc30565f1e~mv2.png";
import { getSiteSettingsEntry } from "../lib/content/site";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const settings = await getSiteSettingsEntry();

const navItems = [
  { href: "/", label: "Start" },
  { href: "/neuigkeiten/", label: "News" },
  { href: "/ueber-uns/", label: "Über uns" },
  { href: "/pics-n-vids/", label: "Pics n Vids" },
  { href: "/veranstaltungen/", label: "Events" },
  { href: "/mitgliedschaft/", label: "Mitgliedschaft" },
  { href: "/kontakt/", label: "Kontakt" },
];
---

<header class="relative z-50 border-b border-[#181818] bg-[#303131] text-[#ead871] shadow-[0_8px_24px_-20px_rgba(0,0,0,0.9)]">
  <Container class="py-3">
    <div class="flex items-center justify-between gap-3 lg:gap-5">
      <a class="inline-flex shrink-0 items-center text-[#ead871] no-underline" href="/">
        <img class="h-12 w-12 object-contain" src={crest.src} alt="" width="48" height="43" />
        <span class="sr-only">{settings.data.organizationName}</span>
      </a>

      <nav aria-label="Primary" class="hidden items-center justify-end gap-1 min-[640px]:flex">
        {
          navItems.map((item) => {
            const isActive = currentPath === item.href;

            return (
              <a
                href={item.href}
                aria-current={isActive ? "page" : undefined}
                class:list={[
                  "rounded-sm px-[0.45em] py-[0.6em] text-[length:clamp(0.6875rem,calc((100vw-130px)/52),0.875rem)] font-semibold tracking-[0.02em] lg:px-3 lg:py-2 lg:text-sm lg:tracking-[0.04em] uppercase no-underline transition",
                  isActive
                    ? "bg-[#ead871] text-[#252626]"
                    : "text-[#f4eeb5] hover:bg-white/10 hover:text-white",
                ]}
              >
                {item.label}
              </a>
            );
          })
        }
      </nav>

      <details class="group relative ml-auto min-[640px]:hidden">
        <summary class="flex cursor-pointer list-none items-center gap-2 rounded-sm border border-[#ead871]/60 px-4 py-2 text-sm font-semibold tracking-[0.06em] text-[#f4eeb5] uppercase transition hover:border-[#ead871] hover:bg-white/5 group-open:bg-white/5">
          <span aria-hidden="true" class="text-lg leading-none">☰</span>
          Menü
        </summary>
        <nav
          aria-label="Primary mobile"
          class="absolute top-full right-0 mt-3 grid w-[min(20rem,calc(100vw-2rem))] gap-1 rounded-sm border border-[#ead871]/25 bg-[#292a2a] p-3 shadow-[0_22px_50px_-24px_rgba(0,0,0,0.95)]"
        >
          {
            navItems.map((item) => {
              const isActive = currentPath === item.href;

              return (
                <a
                  href={item.href}
                  aria-current={isActive ? "page" : undefined}
                  class:list={[
                    "rounded-sm border-l-2 px-4 py-3 text-base font-semibold no-underline transition",
                    isActive
                      ? "border-[#b14926] bg-[#ead871] text-[#252626]"
                      : "border-transparent text-[#f4eeb5] hover:border-[#ead871] hover:bg-white/5 hover:text-white",
                  ]}
                >
                  {item.label}
                </a>
              );
            })
          }
        </nav>
      </details>
    </div>
  </Container>
</header>
