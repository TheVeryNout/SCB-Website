---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  align?: "start" | "center";
  class?: string;
}

const {
  eyebrow,
  title,
  intro,
  align = "start",
  class: className,
} = Astro.props;

const isCentered = align === "center";
---

<div
  class:list={[
    "space-y-5",
    isCentered ? "mx-auto flex max-w-3xl flex-col items-center text-center" : "max-w-5xl",
    className,
  ]}
>
  {
    eyebrow ? (
      <p class="inline-flex border-b-2 border-[#b14926] pb-1 text-sm font-bold tracking-[0.18em] text-[#414141] uppercase">
        {eyebrow}
      </p>
    ) : null
  }
  <h1 class="scb-display max-w-5xl text-[clamp(2.75rem,5vw,4.5rem)] leading-none text-[#353636] uppercase text-balance">{title}</h1>
  {
    intro ? (
      <p class="max-w-2xl text-lg leading-8 text-[#414141]">
        {intro}
      </p>
    ) : null
  }
  {Astro.slots.has("default") ? <div class="pt-2"><slot /></div> : null}
</div>
