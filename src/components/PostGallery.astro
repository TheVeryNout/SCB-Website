---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface GalleryItem {
  image: ImageMetadata;
  alt: string;
  caption?: string;
}

interface Props {
  items: GalleryItem[];
}

const { items } = Astro.props;
---

<section aria-labelledby="post-gallery-heading" class="border-t border-[#414141]/20 px-4 py-8 sm:px-8 sm:py-10">
  <div class="mx-auto max-w-5xl">
    <p class="scb-display text-sm tracking-[0.16em] text-[#b14926] uppercase">Bilderstrecke</p>
    <h2 id="post-gallery-heading" class="mt-2 text-2xl font-semibold text-[#414141]">Eindrücke zum Beitrag</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      {
        items.map((item) => (
          <figure class="m-0 overflow-hidden border border-[#414141]/25 bg-[#414141]">
            <a href={item.image.src} target="_blank" rel="noreferrer" class="block no-underline">
              <Image
                src={item.image}
                alt={item.alt}
                widths={[480, 768, 1200]}
                sizes="(min-width: 640px) 34rem, 100vw"
                loading="lazy"
                class="aspect-[4/3] h-full w-full object-cover"
              />
            </a>
            {
              item.caption ? (
                <figcaption class="bg-[#fffdf2] px-4 py-3 text-sm leading-6 text-[#414141]">
                  {item.caption}
                </figcaption>
              ) : null
            }
          </figure>
        ))
      }
    </div>
  </div>
</section>
