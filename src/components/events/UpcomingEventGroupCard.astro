---
import EventMeta from "./EventMeta.astro";
import EventStatusBadge from "./EventStatusBadge.astro";
import { formatGermanDate } from "../../lib/events/engine";
import type { UpcomingEventGroup, WeekdayKey } from "../../lib/events/model";

interface Props {
  group: UpcomingEventGroup;
  compact?: boolean;
}

const { group, compact = false } = Astro.props;
const { nextOccurrence, occurrences } = group;
const laterOccurrences = occurrences.slice(1, compact ? 3 : 5);

const weekdayLabels: Record<WeekdayKey, string> = {
  monday: "Montag",
  tuesday: "Dienstag",
  wednesday: "Mittwoch",
  thursday: "Donnerstag",
  friday: "Freitag",
  saturday: "Samstag",
  sunday: "Sonntag",
};

function joinGerman(items: string[]): string {
  if (items.length < 2) return items[0] ?? "";
  return `${items.slice(0, -1).join(", ")} und ${items.at(-1)}`;
}

function getRecurrenceLabel(): string | undefined {
  const { recurrence } = nextOccurrence;

  if (recurrence.type === "weekly") {
    const weekdays = recurrence.daysOfWeek.length > 0
      ? recurrence.daysOfWeek.map((weekday) => weekdayLabels[weekday])
      : [new Intl.DateTimeFormat("de-DE", { weekday: "long", timeZone: "UTC" }).format(
          new Date(`${nextOccurrence.occurrenceDate}T00:00:00Z`),
        )];
    const weekdayList = joinGerman(weekdays);

    return recurrence.interval === 1
      ? `Jeden ${weekdayList}`
      : `Alle ${recurrence.interval} Wochen: ${weekdayList}`;
  }

  if (recurrence.type === "monthly") {
    const day = recurrence.dayOfMonth ?? Number(nextOccurrence.startDate.slice(-2));
    return recurrence.interval === 1
      ? `Monatlich am ${day}.`
      : `Alle ${recurrence.interval} Monate am ${day}.`;
  }

  return undefined;
}

const recurrenceLabel = getRecurrenceLabel();
---

<article class:list={["group relative cursor-pointer rounded-sm border border-[#414141]/15 bg-white/85 shadow-[0_14px_32px_-28px_rgba(24,24,24,0.8)] transition hover:border-[#b14926]/45 hover:shadow-[0_18px_38px_-26px_rgba(24,24,24,0.9)]", compact ? "p-4" : "p-5"]}>
  <a
    href={nextOccurrence.occurrencePath}
    class="absolute inset-0 z-0 rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#b14926]"
    aria-label={`${nextOccurrence.title}: ${formatGermanDate(nextOccurrence.occurrenceDate)} ansehen`}
  ></a>
  <div class="flex flex-wrap items-start justify-between gap-3">
    <EventMeta occurrence={nextOccurrence} compact={compact} />
    <EventStatusBadge status={nextOccurrence.status} />
  </div>
  <h3 class:list={["scb-display text-[#414141] transition group-hover:text-[#b14926]", compact ? "mt-3 text-xl" : "mt-3 text-2xl"]}>
    {nextOccurrence.title}
  </h3>
  {recurrenceLabel ? (
    <p class="mt-3 text-xs font-semibold tracking-[0.12em] text-amber-700 uppercase">
      {recurrenceLabel}
    </p>
  ) : null}
  {!compact ? (
    <p class="mt-3 text-sm leading-6 text-[#414141]">{nextOccurrence.summary}</p>
  ) : null}
  {laterOccurrences.length > 0 ? (
    <div class="relative z-10 mt-4 border-t border-[#414141]/10 pt-3">
      <p class="text-xs font-semibold tracking-[0.12em] text-slate-500 uppercase">Weitere Termine</p>
      <ul class="mt-2 flex flex-wrap gap-x-4 gap-y-2 text-sm">
        {laterOccurrences.map((occurrence) => (
          <li>
            <a class="font-semibold text-slate-700 underline decoration-slate-300 underline-offset-4 hover:text-[#b14926]" href={occurrence.occurrencePath}>
              {formatGermanDate(occurrence.occurrenceDate)}
            </a>
          </li>
        ))}
      </ul>
    </div>
  ) : null}
</article>
